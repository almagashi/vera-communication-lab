{
  "manifest_version": 3,
  "name": "Vera Communication Intelligence",
  "description": "Detect authority-softening language and show in-context communication insights.",
  "version": "0.2.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Vera",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

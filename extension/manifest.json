{
  "manifest_version": 3,
  "name": "Vera Communication Intelligence",
  "description": "Detect self-diminishing language in browser text fields and suggest firmer alternatives.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Vera",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
